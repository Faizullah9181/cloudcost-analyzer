# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# LLM Provider: bedrock | openai | anthropic | ollama | gemini | unsloth
LLM_PROVIDER=bedrock

# OpenAI (if using openai provider)
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o

# Gemini (if using gemini provider)
# GEMINI_API_KEY=your-google-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic (if using anthropic provider)
# ANTHROPIC_API_KEY=your-anthropic-key

# Ollama (if using ollama provider)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# Unsloth Studio (if using unsloth provider)
# UNSLOTH_BASE_URL=http://127.0.0.1:8888
# UNSLOTH_USERNAME=unsloth
# UNSLOTH_PASSWORD=12345678
# UNSLOTH_MODEL=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5035
