# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# LLM Provider: bedrock | openai | anthropic | ollama
LLM_PROVIDER=bedrock
# LLM_MODEL=us.anthropic.claude-sonnet-4-20250514

# OpenAI (if using openai provider)
# OPENAI_API_KEY=your-openai-key
# LLM_MODEL=gpt-4o

# Anthropic (if using anthropic provider)
# ANTHROPIC_API_KEY=your-anthropic-key
# LLM_MODEL=claude-sonnet-4-20250514

# Ollama (if using ollama provider)
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=llama3

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5035
