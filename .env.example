# ---------------------------------------------------------------------------
# Shimo configuration. Copy to .env and fill in what you use.
# Every value can also be supplied as a real environment variable.
# ---------------------------------------------------------------------------

# App
APP_NAME=Shimo
DEBUG=false
LOG_LEVEL=INFO

# Database (SQLite by default; any SQLAlchemy URL works)
# Local default: ./data/shimo.db. Docker compose overrides this.
# DATABASE_URL=sqlite:///./data/shimo.db

# ---- AWS ------------------------------------------------------------------
# Leave the keys empty to use ambient credentials (AWS_PROFILE, instance role, SSO).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012

# ---- Azure ----------------------------------------------------------------
# Service principal. Leave empty to use `az login` / managed identity.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# ---- GCP ------------------------------------------------------------------
# Path to a service-account key file, or the JSON itself. Empty = Application Default Credentials.
# GCP_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# GCP_PROJECT_ID=my-project
# Billing export location (BigQuery). Table defaults to gcp_billing_export_v1_* in the dataset.
# GCP_BILLING_PROJECT_ID=my-billing-project
# GCP_BILLING_DATASET=billing_export
# GCP_BILLING_TABLE=

# ---- DigitalOcean ---------------------------------------------------------
# DIGITALOCEAN_API_TOKEN=

# ---- LLM provider: bedrock | openai | anthropic | gemini | ollama | unsloth --
LLM_PROVIDER=bedrock

# Bedrock (uses the AWS credentials above)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-west-2

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# Gemini (OpenAI-compatible endpoint)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Ollama (local)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# Unsloth Studio (falls back to Gemini when unreachable and GEMINI_API_KEY is set)
# UNSLOTH_BASE_URL=http://127.0.0.1:8888
# UNSLOTH_USERNAME=unsloth
# UNSLOTH_PASSWORD=12345678
# UNSLOTH_MODEL=

# ---- Agent & memory -------------------------------------------------------
AGENT_MAX_TOKENS=8192
MEMORY_COMPRESSION_THRESHOLD=20
MEMORY_RECENT_WINDOW=10

# ---- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5035
